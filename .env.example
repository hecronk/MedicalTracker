# Telegram Bot
BOT_TOKEN=your_bot_token_here

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=medicaltracker
DB_ECHO=false

# Scheduler
SCHEDULER_TIMEZONE=UTC

# Retry settings
MAX_RETRY_ATTEMPTS=5

# MTProto Proxy (optional)
# Формат: mtproto://proxy_host:proxy_port:secret
# Пример: mtproto://proxy.example.com:443:dddddddddddddddddddddddddddddddd
MTPROTO_PROXY_URL=
